// S+N++ 2.0 — find, zip, map_merge
fn main() -> Int {
    let xs = [1, 3, 5, 7, 9];
    let i = list_find(xs, fn(x: Int) -> Bool { return x > 6; });
    let pairs = list_zip([1, 2, 3], [10, 20]);
    let m = map_merge(map("score", 100), map("level", 2));
    assert(!list_is_empty(pairs), "pairs");
    assert(!str_is_empty("ok"), "str");
    print(i);
    return i + list_len(pairs) + map_get(m, "score");
}
